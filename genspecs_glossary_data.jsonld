        {
          "term": "International Organization for Standardization",
          "abbreviation": "ISO",
          "definition": "A global body developing voluntary standards for quality, safety, and efficiency across industries.",
          "links": [
            {
              "url": "https://www.iso.org/"
            }
          ],
          "examples": [],
          "crossRefs": [],
