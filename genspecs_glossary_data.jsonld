          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1-128_symbology"
        },
        {
          "term": "GS1-8 Prefix",
          "definition": "A unique string of two or more digits issued by GS1 Global Office and allocated to GS1 Member Organisations to issue GTIN-8s or allocated to issue RCN-8s (see RCN-8).",
          "links": [],
          "examples": [],
          "crossRefs": [],
