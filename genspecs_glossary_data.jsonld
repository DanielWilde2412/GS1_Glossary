        },
        {
          "term": "general retail products",
          "definition": "All trade items that cross point-of-sale.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "general_retail_products"
        },
        {
          "term": "GLN extension component",
          "definition": "A component used to identify internal physical sub-locations within a location (such as a selling floor area, a specific area on a shelf, etc.) which is identified with a GLN (such as stores, factories, buildings, etc.).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gln_extension_component",
          "img": "glossaryImages:GLN_or_GLN_plus_extension.svg"
        },
        {
          "term": "Global Coupon Number",
          "abbreviation": "GCN",
          "definition": "The GS1 identification key used to identify a coupon. The key comprises a GS1 Company Prefix, coupon reference, check digit and an optional serial number.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gcn"
        },
        {
          "term": "Global Data Synchronisation Network",
          "abbreviation": "GDSN",
          "definition": "An Internet-based, interconnected network of interoperable data pools and a Global Registry, the GS1 Global Registry, that enables companies around the world to exchange standardised and synchronised supply chain data with their trading partners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gdsn"
        },
        {
          "term": "Global Document Type Identifier",
          "abbreviation": "GDTI",
          "definition": "The GS1 identification key used to identify a document type. The key comprises a GS1 Company Prefix, document type, check digit and optional serial number.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gdti"
        },
        {
          "term": "Global Identification Number for Consignment",
          "abbreviation": "GINC",
          "definition": "The GS1 identification key used to identify a logical grouping of logistic or transport units that are assembled to be transported under one transport document (e.g., waybill). The key comprises a GS1 Company Prefix and the freight forwarder’s or carrier’s transport reference.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "ginc"
        },
        {
          "term": "Global Individual Asset Identifier",
          "abbreviation": "GIAI",
          "definition": "The GS1 identification key used to identify an individual asset. The key comprises a GS1 Company Prefix and individual asset reference.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "giai",
          "img": "glossaryImages:GIAI_individual_asset_tracking.svg"
        },
        {
          "term": "Global Location Number",
          "abbreviation": "GLN",
          "definition": "The GS1 identification key used to identify locations or parties. The key comprises a GS1 Company Prefix, location reference and check digit.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gln",
          "img": "glossaryImages:GLN_or_GLN_plus_extension.svg"
        },
        {
          "term": "Global Model Number",
          "abbreviation": "GMN",
          "definition": "The GS1 identification key used to identify a product model or product family. The key comprises a GS1 Company Prefix, model reference and a check character pair.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gmn"
        },
        {
          "term": "Global Returnable Asset Identifier",
          "abbreviation": "GRAI",
          "definition": "The GS1 identification key used to identify returnable assets. The key comprises a GS1 Company Prefix, asset type, check digit and optional serial number.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "grai",
          "img": "glossaryImages:GRAI_for_reusable_returnable_assets.svg"
        },
        {
          "term": "Global Service Relation Number",
          "abbreviation": "GSRN",
          "definition": "The GS1 identification key used to identify the relationship between an organisation offering services and the recipient or provider of services. The key comprises a GS1 Company Prefix, service reference and check digit.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gsrn",
          "img": "glossaryImages:GSRN_patient_wristband_alt.svg"
        },
        {
          "term": "Global Shipment Identification Number",
          "abbreviation": "GSIN",
          "definition": "The GS1 identification key used to identify a logical grouping of logistic or transport units that are assembled by the consignor (seller) for a transport shipment from that consignor to one consignee (buyer) referencing a despatch advice and/or BOL. The key comprises a GS1 Company Prefix, shipper reference and check digit.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gsin"
        },
        {
          "term": "Global Trade Item Number",
          "abbreviation": "GTIN",
          "definition": "The GS1 identification key used to identify trade items. The key comprises a GS1 Company Prefix, an item reference and check digit.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin"
        },
        {
          "term": "GS1 Application Identifier",
          "abbreviation": "GS1 AI",
          "definition": "The field of two or more digits at the beginning of an element string that uniquely defines its format and meaning.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1 ai"
        },
        {
          "term": "GS1 Application Identifier data field",
          "definition": "The data used in a business application defined by one GS1 Application Identifier.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_application_identifier_data_field"
        },
        {
          "term": "GS1 check character calculation",
          "definition": "An algorithm used by the GS1 system for the calculation of the check characters to verify accuracy of data.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_check_character_calculation"
        },
        {
          "term": "GS1 check character pair",
          "definition": "A final character pair calculated from the other characters of the Global Model Number. These characters are used to check that the data has been correctly composed and transmitted.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_check_character_pair"
        },
        {
          "term": "GS1 check digit calculation",
          "definition": "An algorithm used by the GS1 system for the calculation of a check digit to verify accuracy of data. (e.g., modulo 10 check digit, price check digit).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_check_digit_calculation"
        },
        {
          "term": "GS1 Common Currency Coupon Code",
          "definition": "An identification number for coupons issued in a common currency area (e.g., the euro currency) that uses the GS1 Prefixes 981-983.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_common_currency_coupon_code"
        },
        {
          "term": "GS1 Company Prefix",
          "abbreviation": "GCP",
          "definition": "A unique string of four to twelve digits used to issue GS1 identification keys. The first digits are a valid GS1 Prefix. The length of the GS1 Company Prefix must be at least one longer than the length of the GS1 Prefix. The GS1 Company Prefix is issued by a GS1 Member Organisation. As the GS1 Company Prefix varies in length, the issuance of a GS1 Company Prefix excludes all longer strings that start with the same digits from being issued as GS1 Company Prefixes.See also U.P.C Company Prefix.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gcp"
        },
        {
          "term": "GS1 Composite symbology",
          "definition": "A symbology consisting of a linear component (encoding the item's primary identification) associated with an adjacent Composite Component (encoding attribute data, such as a batch number or expiration date). The composite symbol always includes a linear component so that the primary identification is readable by all scanning technologies, and so that imager scanners can use the linear component as a finder pattern for the adjacent 2D Composite Component. The composite symbol always includes one of three multi-row 2D Composite Component versions (e.g., CC-A, CC-B, CC-C) for compatibility with linear- and area-CCD scanners and with linear and rastering laser scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_composite_symbology"
        },
        {
          "term": "GS1 conformant barcode",
          "definition": "A family of symbols comprising all barcodes in accordance with an application standard, the data carrier specifications and relevant GS1 symbol specification table.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_conformant_barcode"
        },
        {
          "term": "GS1 DataBar Composite symbology family",
          "definition": "A family of symbols comprising all the GS1 DataBar barcodes when an accompanying Composite Component is printed directly above the linear component.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_composite_symbology_family"
        },
        {
          "term": "GS1 DataBar Expanded barcode",
          "definition": "A barcode that encodes any GS1 identification key plus attribute data, such as weight and “best before” date, in a linear symbol that can be scanned omnidirectionally by suitably programmed point-of-sale scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_expanded_barcode",
          "img": "glossaryImages:GS1DataBarExpandedBarcode.svg"
        },
        {
          "term": "GS1 DataBar Expanded Stacked barcode",
          "definition": "A barcode that is a variation of the GS1 DataBar Expanded barcode that is stacked in multiple rows and is used when the normal symbol would be too wide for the application.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_expanded_stacked_barcode",
          "img": "glossaryImages:GS1DataBarExpandedStacked.svg"
        },
        {
          "term": "GS1 DataBar Limited barcode",
          "definition": "A barcode that encodes a GTIN with a leading digit of zero or indicator digit of one in a linear symbol; for use on small items that will not be scanned at the point-of-sale.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_limited_barcode",
          "img": "glossaryImages:DataBarLimitedBarcode.svg"
        },
        {
          "term": "GS1 DataBar Omnidirectional barcode",
          "definition": "A barcode that encodes a GTIN. It is designed to be read by omnidirectional scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_omnidirectional_barcode",
          "img": "glossaryImages:DataBarOmnidirectionalBarcode.svg"
        },
        {
          "term": "GS1 DataBar Retail POS family",
          "definition": "The members of the GS1 DataBar symbology family designed to be read in segments by omnidirectional scanners at retail POS: GS1 DataBar Omnidirectional; GS1 DataBar Stacked Omnidirectional; GS1 DataBar Expanded; GS1 DataBar Expanded Stacked.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_retail_pos_family"
        },
        {
          "term": "GS1 DataBar Stacked barcode",
          "definition": "A barcode that is a variation of the GS1 DataBar Truncated barcode that is stacked in two rows and is used when the GS1 DataBar Truncated barcode would be too wide for the application.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_stacked_barcode",
          "img": "glossaryImages:DataBarStacked.svg"
        },
        {
          "term": "GS1 DataBar Stacked Omnidirectional barcode",
          "definition": "A barcode that is a variation of the GS1 DataBar symbology that is stacked in two rows and is used when the GS1 DataBar Omnidirectional symbol would be too wide for the application. It is designed to be read by omnidirectional checkout scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_stacked_omnidirectional_barcode",
          "img": "glossaryImages:DataBarStackedOmni.svg"
        },
        {
          "term": "GS1 DataBar Truncated barcode",
          "definition": "A barcode that is a truncated version of the GS1 DataBar Omnidirectional barcode. It is used when the GS1 DataBar Omnidirectional barcode would be too tall for small item marking applications. It is not intended for omnidirectional checkout scanning.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar_truncated_barcode",
          "img": "glossaryImages:GS1DataBarTruncated.svg"
        },
        {
          "term": "GS1 DataBar®",
          "definition": "A family of barcodes, including GS1 DataBar Omnidirectional; GS1 DataBar Stacked Omnidirectional; GS1 DataBar Expanded; GS1 DataBar Expanded Stacked GS1 DataBar Truncated, GS1 DataBar Limited and GS1 DataBar Stacked symbols.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_databar"
        },
        {
          "term": "GS1 DataMatrix",
          "definition": "A subset of Data Matrix which uses the function that allows the encoding of element strings.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_datamatrix",
          "img": "glossaryImages:GS1_DataMatrix.svg"
        },
        {
          "term": "GS1 data element segment",
          "definition": "Mandatory or optional parts of a data element value e.g., ITIP has two mandatory segments, GTIN in the first segment, then a piece number and total number of pieces in the second segment; GRAI has one mandatory segment for the returnable asset reference number, then an optional segment for a serial number.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_data_element_segment"
        },
        {
          "term": "GS1 Digital Link URI",
          "definition": "A Web URI syntax for expressing GS1 identifier keys and attributes in a format using GS1 Application Identifiers and GS1 Application Identifier data fields as specified in the GS1 Digital Link standard.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_digital_link_uri"
        },
        {
          "term": "GS1 DotCode",
          "definition": "A subset of AIM DotCode which uses the function that allows the encoding of element strings.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_dotcode",
          "img": "glossaryImages:GS1_DotCode.svg"
        },
        {
          "term": "GS1 EANCOM®",
          "definition": "The GS1 standard for Electronic Data Interchange (EDI) that is a detailed implementation guideline of the UN/EDIFACT standard messages using the GS1 identification keys.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_eancom"
        },
        {
          "term": "GS1 element string",
          "definition": "A syntax for expressing GS1 identifier keys and attributes in a format using GS1 Application Identifiers and GS1 Application Identifier data fields.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_element_string"
        },
        {
          "term": "GS1 Global Office",
          "abbreviation": "GS1 GO",
          "definition": "GS1 is a neutral, not-for-profit organisation that provides global standards for efficient business communication. GS1 Global Office, located in Brussels (Belgium) and Ewing, NJ (USA) is the guardian, and provides an open, user-driven, forum for ongoing maintenance and development, of the GS1 standards, guidelines and statutes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1 go"
        },
        {
          "term": "GS1 Global Standards Management Process",
          "abbreviation": "GSMP",
          "definition": "The process created by GS1 to support standards development activity for the GS1 system. The GSMP uses a global consensus process to develop supply chain standards that are based on business needs and user-input.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gsmp"
        },
        {
          "term": "GS1 identification key",
          "abbreviation": "GS1 key",
          "definition": "Numeric or alphanumeric strings that incorporate a GS1 Prefix, GS1 Company Prefix or GS1-8 Prefix and are the basis of the unique GS1 identifiers defined for use in an area of GS1 system application such as trade, logistics, or asset management. They may identify a class of entities (e.g., a trade item) or an instance of an entity (e.g., a logistic unit). The term GS1 identification key is for broad communications such as for marketing, licensing, policy etc",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1 key"
        },
        {
          "term": "GS1 identification licensee",
          "definition": "The person (natural or legal) to which the right to use a GS1 Company Prefix or a GS1 identification key has been granted through an agreement with a GS1 Member Organisation or GS1 Global Office, acting as licensor. GS1 identification licensees may use the licensed GS1 Company Prefix or GS1 identification key, subject to any terms and conditions in place when the licence was granted or set by the licensor from time to time, until such time as the agreement under which the licence was granted expires or in perpetuity if the agreement has no expiration date.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_identification_licensee"
        },
        {
          "term": "GS1 identifier",
          "definition": "Data element(s) that expresses a GS1 identification key with or without a GS1 identifier extension, to identify an entity and connect to information about that entity. The term GS1 identifier is for greater precision at the technical level, such as for GS1 standards, GS1 guidelines and end-user implementations.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_identifier"
        },
        {
          "term": "GS1 identifier extension",
          "definition": "Data element that can be used with a simple GS1 identifier to form a compound GS1 identifier.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_identifier_extension"
        },
        {
          "term": "GS1 informative data",
          "definition": "A data element that provides information about an entity identified with a GS1 identifier, such as a use by date, its weight, or country of origin code, for the purpose of informing or completing an action or decision.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_informative_data"
        },
        {
          "term": "GS1 Member Organisation",
          "abbreviation": "GS1 MO",
          "definition": "A member of GS1 that is responsible for administering the GS1 system in its country (or assigned area). This task includes, but is not restricted to, ensuring user companies make correct use of the GS1 system, have access to education, training, promotion and implementation support and have access to play an active role in GSMP.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1 mo"
        },
        {
          "term": "GS1 Prefix",
          "definition": "A unique string of two or more digits issued by GS1 Global Office and allocated to GS1 Member Organisations to issue GS1 Company Prefixes or allocated to other specific areas.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_prefix"
        },
        {
          "term": "GS1 QR Code",
          "definition": "A subset of QR Code which uses the function that allows the encoding of element strings.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_qr_code",
          "img": "glossaryImages:GS1_QRCode.svg",
          "isTypeOf": [
            "2d",
            "qr_code_symbology"
          ]
        },
        {
          "term": "GS1 symbologies using GS1 Application Identifiers",
          "definition": "All GS1 endorsed barcode symbologies that can encode more than a GTIN namely GS1-128, GS1 DataMatrix, GS1 DataBar, GS1 QR Code, GS1 DotCode and GS1 Composite.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_symbologies_using_gs1_application_identifiers"
        },
        {
          "term": "GS1 syntax",
          "definition": "A data structure used within the GS1 system of standards for representing data elements. GS1 syntax includes plain syntax, GS1 element string, GS1 Digital Link URI, Electronic Product Code (EPC) URI and EPC binary string.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_syntax"
        },
        {
          "term": "GS1 system",
          "definition": "The sum of all the artefacts created by the GS1 community through GS1’s community development processes, including GS1 standards, GS1 guidelines, GS1 solutions, and GS1 data services.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_system"
        },
        {
          "term": "GS1 UIC Extension 1",
          "definition": "Character that follows and extends the EU 2018/574 UIC to identify a country of ID Issuer’s appointment and operation.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_uic_extension_1"
        },
        {
          "term": "GS1 UIC Extension 2",
          "definition": "Character that follows GS1 UIC Extension 1 and extends the EU 2018/574 UIC to identify whether a GS1 or non-GS1 based algorithm is used.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1_uic_extension_2"
        },
        {
          "term": "GS1 XML",
          "definition": "The GS1 standard for extensible markup language (XML) schemas providing users with a global business messaging language of e-business to conduct efficient internet-based commerce.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
