        },
        {
          "term": "QR Code (GS1 Digital Link URI)",
          "definition": "QR Code encoding data using the uncompressed form of GS1 Digital Link URI syntax.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
