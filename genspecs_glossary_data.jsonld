          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_12"
        },
        {
          "term": "GTIN‑13",
          "definition": "The 13-digit GS1 identification key composed of a GS1 Company Prefix, item reference and check digit used to identify trade items.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_13"
        },
        {
          "term": "GTIN‑14",
          "definition": "The 14-digit GS1 identification key composed of an indicator digit (1-9), GS1 Company Prefix, item reference and check digit used to identify trade items.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_14"
        },
        {
          "term": "GTIN‑8",
          "definition": "The 8-digit GS1 identification key composed of a GS1-8 Prefix, item reference and check digit used to identify trade items.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
