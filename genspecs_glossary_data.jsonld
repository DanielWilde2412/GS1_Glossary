        },
        {
          "term": "point-of-care",
          "abbreviation": "POC",
          "definition": "Location where dispensing or use of a non-retail, regulated healthcare pharmaceutical or medical device to or for a patient occurs.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "poc"
        },
        {
          "term": "point-of-sale",
          "abbreviation": "POS",
          "definition": "The retail checkout where omnidirectional linear barcodes must be used to support high-volume laser-based scanning or low volume checkout where linear barcodes (or for regulated healthcare trade items, GS1 DataMatrix) are used with image-based scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "pos"
        },
        {
          "term": "predefined assortments",
          "definition": "A trade item that comprises a fixed composition of two or more different trade items, each identified with a GTIN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "predefined_assortments"
        },
        {
          "term": "price verifier digit",
          "definition": "A digit calculated from the price element in a Restricted Circulation Number (RCN) that is used to check that the data has been correctly composed.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
