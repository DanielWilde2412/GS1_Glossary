          "id": "ean-8_barcode",
          "img": "glossaryImages:EAN-8BarCode.svg"
        },
        {
          "term": "economic operator",
          "abbreviation": "EOID",
          "definition": "An economic operator is a business or other organisation which supplies goods, works or services within the context of market operations. Related to requirement for EOID for each country in which a party operates a facility.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
