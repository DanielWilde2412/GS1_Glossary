          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_8"
        },
        {
          "term": "guard bar pattern",
          "definition": "An auxiliary pattern of bars and spaces corresponding to start or stop patterns in barcode symbologies, and serving to separate the two halves of EAN-8, EAN-13 and UPC-A symbols.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "guard_bar_pattern",
          "img": "glossaryImages:GuardBarPattern.svg"
        },
        {
          "term": "healthcare primary packaging",
          "definition": "The first level of packaging for the product marked with an AIDC data carrier either on the packaging or on a label affixed to the packaging. For non-sterile packaging, the first level of packaging can be the packaging in direct contact with the product. For sterile packaging, the first level of packaging can be any combination of the sterile packaging system, may consist of a single item or group of items for a single therapy such as a kit. For packaging configurations that include a retail consumer trade item, primary packaging is a packaging level below the retail consumer trade item.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "healthcare_primary_packaging"
        },
        {
          "term": "healthcare provider",
          "definition": "An organisation or facility that delivers healthcare to a subject of care. Corresponds to “care delivery organisation”, “healthcare organisation”, etc.",
          "links": [],
          "examples": [
            "care delivery organisation",
            "healthcare organisation"
          ],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "healthcare_provider"
        },
        {
          "term": "healthcare secondary packaging",
          "definition": "A level of packaging marked with an AIDC carrier that may contain one or more primary packages each of which may contain a single item or multiple items.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "healthcare_secondary_packaging"
        },
        {
          "term": "Highly Individualised Device",
          "definition": "Device subject to EUDAMED registration via MUDI-DI as UDI-DI",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg/2017/745/oj/",
              "label": "EU medical device regulation 2017/745"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "highly_individualised_device"
        },
        {
          "term": "Highly Individualised Device Registration Identifier",
          "abbreviation": "HIDRI",
          "definition": "A special version of the Global Model Number that identifies a group of highly individualised medical devices within EUDAMED.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "hidri"
        },
        {
          "term": "House Waybill Number",
          "definition": "A freight forwarder’s document used mainly as a control for the goods within the freight forwarder’s own service system.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "house_waybill_number"
        },
        {
          "term": "human readable interpretation",
          "abbreviation": "HRI",
          "definition": "Characters, such as letters and numbers, which can be read by persons and are encoded in GS1 AIDC data carriers confined to a GS1 standard structure and format. The human readable interpretation is the encoded data. Start, stop, shift and function characters, as well as the symbol check character, are not shown in the human readable interpretation.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "hri",
          "img": "glossaryImages:HRI_as_backup_when_barcode_does_not_scan.svg"
        },
        {
          "term": "human readable text",
          "definition": "Refers to HRI and/or non-HRI text collectively, when referencing data that is encoded into a data carrier.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "human_readable_text"
        },
        {
          "term": "Identification of an individual trade item piece",
          "abbreviation": "ITIP",
          "definition": "Identifies an individual piece of a trade item that is not traded independently and therefore cannot be assigned its own GTIN.  It has two mandatory segments, GTIN in the first segment (which is the GTIN for the complete trade item, represented as 14 digits), then a two-digit piece number (that identifies the individual piece of a trade item, such as the left shoe of a pair of shoes) and two-digit total number of pieces within the second four-digit segment.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "itip"
        },
        {
          "term": "Importer index",
          "definition": "Character to identify the presence or absence of an importer within the EU 2018/574 EOID, FID and MID. This means either the absence of an importer (null) or presence of one importer out of up to 63 importer possibilities per country, per GTIN.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "importer_index"
        },
        {
          "term": "indicator",
          "definition": "A digit from 1 to 9 in the leftmost position of the GTIN-14.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "indicator"
        },
        {
          "term": "indirect mode",
          "definition": "Mobile device information retrieval function when the code contains an identifier, which needs to be resolved to obtain the content or service. Resolving an identifier means looking it up, typically at a network service, to determine the corresponding content or service.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "indirect_mode"
        },
        {
          "term": "individual asset",
          "definition": "An object that is part of the inventory of assets for a given company.(See also returnable asset.)",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "individual_asset"
        },
        {
          "term": "individual asset reference",
          "definition": "A component of the Global Individual Asset Identifier (GIAI) assigned by the asset owner or manager to create a unique GIAI.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "individual_asset_reference"
        },
        {
          "term": "individual provider",
