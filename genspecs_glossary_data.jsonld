          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "rcn-8"
        },
        {
          "term": "Reduced Space Symbology",
          "abbreviation": "RSS",
          "definition": "Deprecated in favour of: GS1 DataBar Symbology",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "rss"
        },
        {
          "term": "refund receipt",
          "definition": "A voucher produced by equipment handling empty containers (i.e., bottles and crates).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "refund_receipt"
        },
        {
          "term": "regular expression",
          "definition": "A sequence of characters that specifies a search pattern that is usually used by string-searching algorithms for search / find-and-replace operations on strings or for validation of string input.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "regular_expression"
        },
        {
          "term": "regulated healthcare non-retail consumer trade item",
          "definition": "A regulated healthcare trade item not intended for scanning at POS and identified with a GTIN-14, GTIN-13, GTIN-12 or GTIN-8 utilising linear or 2D barcodes that can be scanned by image-based scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "regulated_healthcare_non-retail_consumer_trade_item"
        },
        {
          "term": "regulated healthcare retail consumer trade item",
          "definition": "A regulated healthcare trade item to be sold to the end consumers at a regulated healthcare retail point-of-sale (i.e., pharmacies). They are identified with a GTIN-13, GTIN-12 or GTIN-8 utilising linear or GS1 DataMatrix barcodes that can be scanned by image-based scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "regulated_healthcare_retail_consumer_trade_item"
        },
        {
          "term": "regulated healthcare trade item",
          "abbreviation": "RHTI",
          "definition": "Pharmaceuticals or medical devices that are sold or dispensed in a controlled environment (e.g., retail pharmacy, hospital pharmacy).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "rhti"
        },
        {
          "term": "responsible entity",
          "definition": "The party responsible for the safety and effectiveness of the medical product at a moment in time in its life cycle, according to the approved regulatory file (including labelling) and regulatory/legal/professional obligations associated with the medical product. (e.g., brand owner, repackager, hospital pharmacy, etc.)",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "responsible_entity"
        },
        {
          "term": "Restricted Circulation Number",
          "abbreviation": "RCN",
          "definition": "An identification number used for special applications in restricted environments, either defined by local GS1 Member Organisations (for regional applications such as variable measure product identification and, couponing) or by a company (for internal applications).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "rcn"
        },
        {
          "term": "retail consumer trade item variant",
          "definition": "A variation of change to a retail consumer trade item (which may itself be a homogeneous or predefined assortment of other retail consumer trade items) which does not require a new GTIN, but where identification of the variation may be required.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "retail_consumer_trade_item_variant"
        },
        {
          "term": "returnable asset",
          "definition": "A reusable entity owned by a company that is used for transport and storage of goods. It is identified with a GRAI.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "returnable_asset"
        },
        {
          "term": "SCC-14",
          "definition": "Deprecated in favour of: Global Trade Item Number",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "scc-14"
        },
        {
          "term": "separator character",
          "definition": "Special character(s) that are defined as part of GS1 symbologies and used to separate concatenated element strings, based on their positioning in the GS1 barcodes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "separator_character"
        },
        {
          "term": "serial number",
          "definition": "A code, numeric or alphanumeric, assigned to an individual instance of an entity for its lifetime. Example: a unique individual item may be identified with the combined Global Trade Item Number (GTIN) and serial number.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "serial_number"
        },
        {
          "term": "serial reference",
          "definition": "A component of the Serial Shipping Container Code (SSCC) assigned by the physical builder or brand owner of the logistic unit to create a unique SSCC.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "serial_reference"
        },
        {
          "term": "Serial Shipping Container Code",
          "abbreviation": "SSCC",
          "definition": "The GS1 identification key used to identify logistics units. The key comprises an extension digit, GS1 Company Prefix, serial reference and check digit.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "sscc",
          "img": "glossaryImages:item_case_pallet_and_identifiers.svg"
        },
        {
          "term": "service reference",
          "definition": "A component of the Global Service Relation Number (GSRN) assigned by the issuing organisation to create a unique GSRN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "service_reference"
        },
        {
          "term": "service relation instance number",
          "abbreviation": "SRIN",
          "definition": "An attribute to the GSRN which allows to distinguish different encounters during a service relationship.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "srin"
        },
        {
          "term": "shipment",
          "definition": "A grouping of logistic and transport units assembled and identified by the seller (sender) of the goods travelling under one despatch advice and/or Bill of Lading to one customer (recipient).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "shipment"
        },
        {
          "term": "short life items",
          "definition": "An item, preparation or reconstituted product with limited use/shelf life.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "short_life_items"
        },
        {
          "term": "simple GS1 identifier",
          "definition": "A single data element that identifies an entity at class level or instance level.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "simple_gs1_identifier"
        },
        {
          "term": "single unit package/blister",
          "definition": "A healthcare primary package that contains one discrete pharmaceutical dosage form, i.e. a tablet, a certain volume of a liquid or that is the immediate package for a medical device like a syringe. A number of single units attached to each other, but are easily separated through a perforation would be included.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
