          "id": "fid"
        },
        {
          "term": "fixed length",
          "definition": "Term used to describe a data field in an element string with an established number of characters.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "fixed_length"
        },
        {
          "term": "fixed measure trade item",
          "definition": "An item always produced in the same predefined version (e.g., type, size, weight, contents, design) that may be sold at any point in the supply chain.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "fixed_measure_trade_item",
          "img": "glossaryImages:FixedMeasure-vs-VariableMeasure.svg"
        },
        {
          "term": "freight forwarder",
          "definition": "The party that arranges the carriage of goods including connected services and/or associated formalities on behalf of the shipper (consignor) or consignee.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "freight_forwarder"
        },
        {
          "term": "fresh foods",
          "definition": "Trade items in the following product categories: fruits, vegetables, meats, seafood, bakery and ready to serve food such as cheeses, cold cooked or cured meats and salad, etc. Fresh foods are defined as food that is not preserved by canning, dehydration, freezing or smoking.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "fresh_foods"
        },
        {
          "term": "full string",
          "definition": "The data transmitted by the barcode reader from reading a data carrier, including the symbology identifier as well as the encoded data.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "full_string"
        },
        {
          "term": "Function 1 Symbol Character",
          "abbreviation": "FNC1",
          "definition": "A symbology character used in some GS1 data carriers for specific purposes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
