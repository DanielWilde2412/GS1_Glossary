          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "extension_digit"
        },
        {
          "term": "Facility Identifier",
          "abbreviation": "FID",
          "definition": "A unique identifier assigned by authorized ID issuers to every location where tobacco products are manufactured, stored, or first sold.",
          "links": [
