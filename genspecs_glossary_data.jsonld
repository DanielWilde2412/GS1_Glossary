          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "ean_upc_symbology"
        },
        {
          "term": "EAN-13 barcode",
          "definition": "A barcode of the EAN/UPC symbology that encodes GTIN-13 or RCN-13.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "ean-13_barcode",
          "img": "glossaryImages:EAN-13BarCode.svg"
        },
        {
          "term": "EAN-8 barcode",
