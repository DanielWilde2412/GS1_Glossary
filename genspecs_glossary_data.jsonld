        {
          "term": "general distribution scanning",
          "definition": "Scanning environments that process barcoded trade items packaged for transport, logistic units, assets and location tags.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "general_distribution_scanning"
        },
        {
          "term": "general retail consumer trade item",
          "definition": "A trade item intended to be sold at retail point-of-sale identified with a GTIN-13, GTIN-12 or GTIN-8 utilising omnidirectional linear barcodes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
