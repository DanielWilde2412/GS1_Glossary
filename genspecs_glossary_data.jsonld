          "id": "payment_slip"
        },
        {
          "term": "physical trade item assortment/bundle",
          "definition": "A combination of different trade items that are physically combined into a single trade item, thus creating a new trade item.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
