        },
        {
          "term": "consumer product variant",
          "abbreviation": "CPV",
          "definition": "An alphanumeric attribute of a GTIN assigned to a retail consumer trade item variant for its lifetime.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "cpv"
        },
        {
          "term": "country subdivision",
          "definition": "Principle administrative divisions, or similar areas, of a country included in ISO 3166-1. Examples are a state in the US, a region in France, a canton in Switzerland.",
          "links": [],
          "examples": [],
