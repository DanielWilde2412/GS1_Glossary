          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "packaging_component_number"
        },
        {
          "term": "payment slip",
          "definition": "The end customer’s notification of a demand for payment for a billable service (e.g., utility bill) comprising an amount payable and payment conditions.",
          "links": [],
          "examples": [],
          "crossRefs": [],
