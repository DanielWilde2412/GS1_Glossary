          "id": "odd_parity"
        },
        {
          "term": "offer declarations",
          "definition": "The set of all information declared (or agreed to) by the seller about the trade item (inclusive of price, availability, terms of sale, claims, condition, shipping information, returns information, etc).",
          "links": [],
          "examples": [],
          "crossRefs": [],
