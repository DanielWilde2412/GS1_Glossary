        },
        {
          "term": "data element field",
          "definition": "The data container (e.g., within a document or message or dataset) where a data element value is encoded, stored, queried, or transmitted.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_element_field"
        },
        {
          "term": "data element qualifier",
          "definition": "A set of characters that designate the meaning, character set, format and length of the data element value that it precedes or represents, as defined by the relevant technology e.g., GS1 Application Identifiers for implicit or explicit encoding in AIDC data carriers, data titles for physical labels or data base fields, GS1 Web Vocabulary properties for JSON/XML applications, etc.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_element_qualifier"
        },
        {
          "term": "data element qualifier-value pair",
          "definition": "Combination of a data element qualifier and data element value. Also known within technology specific standards as a name-value pair, key-value pair, property-value pair, attribute-value pair or a GS1 element string (which combines a GS1 Application Identifier and a GS1 Application Identifier data field).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_element_qualifier-value_pair"
        },
        {
          "term": "Data element value",
          "definition": "The characters that comprise a data element (e.g., ABC123, 220708, 117 Hopkins Street).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_element_value"
        },
        {
          "term": "data field",
          "definition": "A field that contains a GS1 identification key, an RCN, or attribute information.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_field"
        },
        {
          "term": "Data Matrix (GS1 Digital Link URI)",
          "definition": "Data Matrix encoding data using the uncompressed form of the GS1 Digital Link URI syntax.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_matrix_gs1_digital_link_uri",
          "img": "glossaryImages:DataMatrixGS1DigitalLinkURI.svg"
        },
        {
          "term": "Data Matrix symbology",
          "definition": "A standalone, two-dimensional barcode symbology that is made up of square modules arranged within a perimeter finder pattern. Data Matrix using ECC 200 error correction is the only version that supports GS1 system identification keys, including the Function 1 Symbol Character (FNC1). Data Matrix symbols are read by two-dimensional imaging scanners or vision systems.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_matrix_symbology",
          "img": "glossaryImages:DataMatrixSymbology_BarText.svg",
          "isTypeOf": [
            "2d"
          ]
        },
        {
          "term": "data titles",
          "definition": "Data titles are the abbreviated descriptions of element strings which are used to support manual interpretation of barcodes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "data_titles"
        },
        {
          "term": "digital coupon",
          "definition": "A digital coupon is an electronic representation of a coupon, that is distributed and presented without manifesting as “paper” or in other hard-copy form, and that can be exchanged for a financial saving or for loyalty points when making a purchase.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "digital_coupon"
        },
        {
          "term": "Digital Signature",
          "abbreviation": "DigSig",
          "definition": "A data construct for encoding a digital signature within a data carrier, providing a method to authenticate barcode and RFID data. It also provides a method to link the barcode and RFID data to the labelled/tagged object. The ISO/IEC 20248 data construct which contains a X.509 digital signature is known as a DigSig. \"digital signature\" in lower case refers to digital signatures in general, whilst “Digital Signature” with capitals, is a named thing with the specific meaning of “DigSig”.",
          "links": [
            {
              "url": "https://www.iso.org/standard/81314.html",
              "label": "ISO/IEC 20248"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "digsig"
        },
        {
          "term": "digital signature",
          "definition": "A compact fingerprint of data that supports tamper-detection and non-repudiation by the party who digitally signed the data. A digital signature is constructed by hashing the data then encrypting the hash using a private key. This enables independent verification by anyone, using the public key corresponding to the private key.NOTE: “digital signature” in lower case refers to digital signatures in general, whilst \"Digital Signature\" with capitals, is a named thing with the specific meaning of \"DigSig”.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "digital_signature"
        },
        {
          "term": "direct mode",
          "definition": "Mobile device information retrieval function when the barcode contains either the address (URL) of the content or service, or the content itself, in-line.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "direct_mode"
        },
        {
          "term": "direct part marking",
          "abbreviation": "DPM",
          "definition": "The process of marking a symbol on an item using an intrusive or non-intrusive method.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "dpm"
        },
        {
          "term": "direct print",
          "definition": "A process in which the printing apparatus prints the symbol by making physical contact with a substrate (e.g., flexography, ink jet, dot peening).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "direct_print"
        },
        {
          "term": "document type",
          "definition": "A component of a Global Document Type Identifier (GDTI) assigned by the document issuer to create a unique GDTI.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "document_type"
        },
        {
          "term": "dynamic assortment",
          "definition": "A trade item that comprises a variable composition of a fixed total count of two or more different trade items, each identified with a GTIN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "dynamic_assortment"
        },
        {
          "term": "EAN/UPC symbology",
          "definition": "A family of barcodes including EAN-8, EAN-13, UPC-A and UPC-E barcodes as well as the 2- and 5-digit add-ons. See also EAN-8 barcode, EAN-13 barcode, UPC-A barcode and UPC-E barcode.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
