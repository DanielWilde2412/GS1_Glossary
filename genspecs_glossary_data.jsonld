          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "offer_declarations"
        },
        {
          "term": "omnidirectional linear barcode",
          "definition": "A linear barcode symbology designed to be read in segments by suitably programmed laser point-of-sale (POS) scanners.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
