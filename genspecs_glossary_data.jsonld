          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "number_system_character"
        },
        {
          "term": "odd parity",
          "definition": "A characteristic of the encodation of a symbol character whereby the symbol character contains an odd number of dark modules.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
