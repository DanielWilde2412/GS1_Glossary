          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "rcn-13"
        },
        {
          "term": "RCN-8",
          "definition": "An 8-digit Restricted Circulation Number (see Restricted Circulation Number)",
          "links": [],
          "examples": [],
          "crossRefs": [],
