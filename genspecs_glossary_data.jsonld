        {
          "term": "inverse exponent",
          "definition": "The GS1 Application Identifier digit that denotes the implied decimal point position in an element string.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "inverse_exponent"
        },
        {
          "term": "issuance",
          "definition": "The generation of a GS1 Prefix, GS1 Company Prefix, or GS1 identification key in accordance with GS1 rules and policies by GS1 or a GS1 Member Organisation.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "issuance"
        },
        {
          "term": "item reference",
          "definition": "A component of the Global Trade Item Number (GTIN) assigned by the brand owner to create a unique GTIN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "item_reference"
        },
        {
          "term": "ITF-14 barcode",
          "definition": "ITF-14 (a subset of Interleaved 2-of-5) barcodes carry GTINs only on trade items that are not expected to pass through the point-of-sale.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "itf-14_barcode"
        },
        {
          "term": "kit",
          "definition": "A collection of different regulated healthcare items assembled for use in a single therapy.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "kit"
        },
        {
          "term": "leading zero(es)",
          "definition": "Adding zeroes in the leftmost position(s) of a data string when GTIN-8, GTIN-12, or GTIN-13 are encoded in an GS1 AIDC data carrier, message, or database that requires 14-digits or when used for the same intent in other data structures such as GRAI.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "leading_zero_es"
        },
        {
          "term": "levels of AIDC marking",
          "definition": "A graduated system of AIDC marking. The graduated system is defined as minimum, enhanced and highest levels of AIDC marking.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "levels_of_aidc_marking"
        },
        {
          "term": "linear barcode",
          "definition": "Barcode symbology using bars and spaces in one dimension.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "linear_barcode"
        },
        {
          "term": "local assigned code",
          "abbreviation": "LAC",
          "definition": "A particular use of the UPC-E barcode for restricted distribution.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "lac"
        },
        {
          "term": "location reference",
          "definition": "A component of a Global Location Number (GLN) that allows the party defining the party or location to create a unique GLN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "location_reference"
        },
        {
          "term": "logistic measures",
          "definition": "Measures indicating the outside dimensions, total weight, or volume inclusive of packing material of a logistic unit. Also known as gross measures.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "logistic_measures"
        },
        {
          "term": "logistic unit",
          "definition": "An item of any composition established for transport and/or storage that needs to be managed through the supply chain. It is identified with a Serial Shipping Container Code (SSCC).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "logistic_unit"
        },
        {
          "term": "Made-to-Order trade item",
          "abbreviation": "MtO",
          "definition": "A bespoke (e.g., customised, personalised, configurable) product or service where the GTIN, allocated per application specific rules rather than the GTIN Management Standard, plus a compound key data element (Made-to-Order variant, lot number, serial number) is required to distinguish whenever any of the trade item declarations are different in any way that is relevant to the trading process.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "mto"
        },
        {
          "term": "Made-to-Stock trade item",
          "abbreviation": "MtS",
          "definition": "A product or service where a separate, unique GTIN, allocated per the GTIN Management Standard, is required to distinguish whenever any of the trade item declarations are different in any way that is relevant to the trading process.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "mts"
        },
        {
          "term": "Magnification",
          "definition": "Deprecated in favour of: X-dimension",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "magnification"
        },
        {
          "term": "main symbol",
          "definition": "The barcode containing the identification number of the item (e.g., GTIN, SSCC). Used to determine the placement of any additional barcode information.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "main_symbol"
        },
        {
          "term": "Master Unique Device Identifier – Device Identifier",
          "abbreviation": "MUDI-DI",
          "definition": "The Master UDI-DI is a unique identifier specific to a family of highly individualised medical devices for the restricted use of EUDAMED registration.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "mudi-di"
        },
        {
          "term": "measure verifier digit",
          "definition": "A digit calculated from the measure field in a Restricted Circulation Number (RCN) that is used to check that the data has been correctly composed.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "measure_verifier_digit"
        },
        {
          "term": "Medical device family",
          "definition": "A group of medical devices manufactured by or for the same organization and have the same basic design and performance characteristics related to safety, intended use and function.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "medical_device_family"
        },
        {
          "term": "merchant",
          "definition": "The party that makes a trade item available for sale. A retailer is one type of merchant. An online seller is another type of merchant.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "merchant"
        },
        {
          "term": "model reference",
          "definition": "A component of the Global Model Number (GMN) assigned by the brand owner to create a unique GMN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "model_reference"
        },
        {
          "term": "module",
          "definition": "The narrowest nominal width unit of measure in a barcode. In certain symbologies, element widths may be specified as multiples of one module. The nominal width (& height for 2D barcodes) of a single module is equivalent to the X-dimension.",
          "links": [],
          "examples": [
