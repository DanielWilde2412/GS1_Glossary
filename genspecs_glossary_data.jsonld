          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "omnidirectional_linear_barcode"
        },
        {
          "term": "packaging component",
          "definition": "Objects such as bottles, caps and labels to package a consumer trade item.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
