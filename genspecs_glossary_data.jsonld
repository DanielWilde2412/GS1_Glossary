      "extractedGlossaryData": [
        {
          "term": "acceptance criteria - TEST",
          "definition": "An allowance for a small measurement variation between commercial verifiers or operators during barcode verification testing.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-11-25",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "acceptance_criteria"
        },
        {
          "term": "add-on symbol",
          "definition": "A barcode used to encode information supplementary to that in the main EAN/UPC barcode.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "add-on_symbol"
        },
        {
          "term": "aggregated packaging",
          "definition": "Any packaging containing more than one unit packet of tobacco products. For GS1, this may be either a trade item grouping or logistics unit.",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aggregated_packaging"
        },
        {
          "term": "aggregate Unique Identifier",
          "abbreviation": "aUI",
          "definition": "An alphanumeric code (maximum 100 characters) used to identify aggregated packaging (e.g., cases, pallets) containing more than one unit packet of tobacco products",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg_impl/2018/574/oj",
              "label": "EU tobacco regulation 2018/574"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aui"
        },
        {
          "term": "AIDC data carrier",
          "definition": "Generic term for a barcode, RFID tag or NFC tag; a means of physically affixing machine-readable data to a physical entity.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aidc_data_carrier"
        },
        {
          "term": "AIDC media",
          "definition": "The specific form of object/entity where a GS1 AIDC data carrier is displayed.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aidc_media"
        },
        {
          "term": "AIDC media type",
          "definition": "The code list for objects/entities (e.g., patient wristband or staff ID card) that displays or carries a GS1 AIDC data carrier.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aidc_media_type"
        },
        {
          "term": "AIDC media type value",
          "definition": "A predefined two-digit numeric code list value used to signify the AIDC media type (e.g., ID = 10, patient wristband = 01).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aidc_media_type_value"
        },
        {
          "term": "AIM DotCode",
          "definition": "A two-dimensional barcode symbology rendered by printing dots per the AIM DotCode Specification.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aim_dotcode"
        },
        {
          "term": "allocation",
          "definition": "The association of an issued GS1 Prefix, GS1 Company Prefix, or GS1 identification key to its corresponding entity or object in accordance with the GS1 rules and policies.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "allocation"
        },
        {
          "term": "alphanumeric",
          "definition": "A character set that contains alphabetic characters (letters), numeric digits (numbers) and other characters, such as punctuation marks.",
          "links": [],
          "examples": [
            "letters",
            "numbers",
            "punctuation marks"
          ],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "alphanumeric"
        },
        {
          "term": "aperture",
          "definition": "A physical opening that is part of the optical path in a device such as a scanner, photometer, or camera. Most apertures are circular, but they may be rectangular or elliptical.",
          "links": [],
          "examples": [
            "circular",
            "rectangular",
            "elliptical"
          ],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aperture"
        },
        {
          "term": "Application Standard Profile",
          "abbreviation": "ASP",
          "definition": "A template that records conformance requirements of existing and any future AIDC application standards, the normative decisions (MSWG, ISO, Regulation, …), maintains centralisation of cross-application rules and related technical specifications.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "asp"
        },
        {
          "term": "asset type",
          "definition": "A component of the Global Returnable Asset Identifier (GRAI), assigned by the asset owner or manager, in order to create a unique GRAI.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "asset_type"
        },
        {
          "term": "attribute",
          "definition": "Additional information about an entity identified with a GS1 identification key.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "attribute"
        },
        {
          "term": "autodiscrimination",
          "definition": "The capability of a reader to automatically recognise and decode multiple barcode symbologies.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "autodiscrimination"
        },
        {
          "term": "automatic identification and data capture",
          "abbreviation": "AIDC",
          "definition": "A technology used to automatically capture data. AIDC technologies include barcodes, smart cards, biometrics and RFID.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "aidc"
        },
        {
          "term": "auxiliary patterns",
          "definition": "Components of the EAN/UPC symbology. The centre guard bar pattern, the left guard bar pattern and the right guard bar pattern are examples of these.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "auxiliary_patterns",
          "img": "glossaryImages:AuxiliaryPatterns.svg"
        },
        {
          "term": "bar gain/loss",
          "definition": "The increase/decrease in bar width due to effects of the reproduction and printing processes.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "bar_gain_loss"
        },
        {
          "term": "barcode",
          "definition": "A symbol that encodes data into a machine readable pattern of adjacent, varying width, parallel, rectangular or square dark and light spaces. The term barcode is inclusive of all linear and two-dimensional (2D) versions.",
          "links": [],
          "examples": [
            "linear",
            "two-dimensional"
          ],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "barcode"
        },
        {
          "term": "barcode verification",
          "definition": "The assessment of the printed quality of a barcode based on ISO/IEC standards using ISO/IEC compliant barcode verifiers.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "barcode_verification"
        },
        {
          "term": "base unit",
          "definition": "In a hierarchy of trade item groupings, the consumer trade item level or unit of use.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "base_unit"
        },
        {
          "term": "Basic Unique Device Identifier – Device Identifier",
          "abbreviation": "BUDI-DI",
          "definition": "A unique identifier specific to a medical device family. It is represented by GS1’s Global Model Number (GMN).",
          "links": [
            {
              "url": "https://eur-lex.europa.eu/eli/reg/2017/745/oj/",
              "label": "EU medical device regulation 2017/745"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "budi-di"
        },
        {
          "term": "batch/lot",
          "definition": "Associates an item with information the manufacturer considers relevant for traceability of the trade item.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "batch_lot"
        },
        {
          "term": "bearer bars",
          "definition": "Bar abutting the tops and bottoms of the bars in a barcode or a frame surrounding the entire symbol, intended to equalise the pressure exerted by the printing plate over the entire surface of the symbol and/or to prevent a partial scan by the barcode reader.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "bearer_bars",
          "img": "glossaryImages:BearerBars.svg"
        },
        {
          "term": "brand owner",
          "definition": "The organisation that owns the specifications of a trade item, regardless of where and by whom it is manufactured. The brand owner is normally responsible for the management of the Global Trade Item Number (GTIN).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "brand_owner"
        },
        {
          "term": "Character Set 39",
          "definition": "A subset of characters found in ISO 646: Unique Graphic Character Allocations which includes numeric, alphabetic upper-case, and the characters “#”, “-“ and “/”.",
          "links": [],
          "examples": [
            "#",
            "-",
            "/"
          ],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "character_set_39"
        },
        {
          "term": "Character Set 64 (file-safe / URI-safe base64)",
          "definition": "A subset of characters found in ISO 646: Unique Graphic Character Allocations and defined by section 5 of RFC4648 as a URI and filename safe base64 alphabet, which includes numeric, alphabetic upper-case and lower-case, plus the characters “-”, “_”. The “=” character is used as a special pad character and has no assigned value. The file-safe URI-safe base64 alphabet is used to represent binary data as compact alphanumeric strings, each character corresponding to a 6-bit value in the range 0-63.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "character_set_64_file-safe_uri-safe_base64"
        },
        {
          "term": "Character Set 82",
          "definition": "A subset of characters found in ISO 646: Unique Graphic Character Allocations which includes numeric, alphabetic upper-case and lower-case, plus twenty special characters but excluding “space”.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "character_set_82"
        },
        {
          "term": "check digit",
          "definition": "Numeric character calculated from data and appended as part of the data string to ensure that the data is correctly composed and transmitted.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "check_digit"
        },
        {
          "term": "class level GS1 identifier",
          "definition": "An identifier of entities which share common characteristics (e.g., all trade items allocated the same GTIN).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "class_level_gs1_identifier"
        },
        {
          "term": "Code 128",
          "definition": "A linear barcode symbology fully described in ISO/IEC 15417 of which GS1-128 is a subset.",
          "links": [
            {
              "url": "https://www.iso.org/standard/87124.html",
              "label": "ISO/IEC 15417:2007/Amd1:2026, Code 128 spec"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "code_128"
        },
        {
          "term": "codeword",
          "definition": "A symbol character value. An intermediate level of coding between source data and the graphical encodation in the symbol.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "codeword"
        },
        {
          "term": "component/part",
          "definition": "An item that is intended to undergo at least one further transformation process to create finished goods for the purpose of downstream consumption.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "component_part"
        },
        {
          "term": "Component/Part Identifier",
          "abbreviation": "CPID",
          "definition": "The unique identifier for a component/part, comprising a GS1 Company Prefix and a component/part reference.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "cpid"
        },
        {
          "term": "Composite Component",
          "definition": "The stacked linear barcode component of a GS1 composite symbol.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "composite_component"
        },
        {
          "term": "compound GS1 identifier",
          "definition": "Two or more data elements that combine a simple GS1 identifier and GS1 identifier extension(s), that identifies entities at sub-class level or instance level, where no subset of those data elements taken by themselves would do so.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "compound_gs1_identifier"
        },
        {
          "term": "concatenation",
          "definition": "The representation of several element strings in one barcode.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "concatenation"
        },
        {
          "term": "Conformant",
          "definition": "The state in which a system meets a specified standard.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "conformant"
        },
        {
          "term": "consignment",
          "definition": "A grouping of logistic or transport units assembled by a freight forwarder or carrier to be transported under one transport document (e.g., waybill).",
          "links": [],
          "examples": [
            "waybill"
          ],
          "crossRefs": [],
