        {
          "term": "multiple unit blister/package",
          "definition": "Immediate package for a medicine with more than one single unit. Package which fully encloses the pill/caplet/capsule. Each dosage form may be individually packaged. The individually blistered dosage forms are attached to each other in one strip.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "multiple_unit_blister_package"
        },
        {
          "term": "National Healthcare Reimbursement Number",
          "abbreviation": "NHRN",
          "definition": "National and/or regional identification numbers used on pharmaceutical and/or medical devices where required by national or regional regulatory organisations for product registration purposes and/or for the management of healthcare provider reimbursement.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "nhrn"
        },
        {
          "term": "National Trade Item Number",
          "abbreviation": "NTIN",
          "definition": "A coding scheme, administered in the healthcare sector by a national organisation for which a GS1 Prefix has been issued to permit its uniqueness within the GTIN pool but without assurance of full compatibility with GTIN functionality. The result is a product identification number assigned by a third party (not the brand owner or manufacturer). Example: the CIP (Club Inter Pharmaceutique) in France administered by the French Health Products Safety Agency (AFSSAPS).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "ntin"
        },
        {
          "term": "near field communication",
          "abbreviation": "NFC",
          "definition": "A technology that uses inductive fields at 13.56 MHz to automatically capture data. An NFC system consists of NFC tags and readers. When interrogated by an NFC reader (initiator), the NFC tag (target) transmits digital data, usually a web URL, back to the reader.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "nfc"
        },
        {
          "term": "NFC Data Exchange Format",
          "abbreviation": "NDEF",
          "definition": "A standard developed by the NFC Forum to encapsulate and exchange application-defined payloads (such as URIs, plain text, or custom data) between NFC-enabled devices and tag.",
          "links": [
            {
              "url": "https://nfc-forum.org/"
            }
          ],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "ndef"
        },
        {
          "term": "non-human readable interpretation text",
          "abbreviation": "non-HRI",
          "definition": "Characters such as letters and numbers that can be read by persons and may or may not be encoded in GS1 AIDC data carriers and are not confined to a structure and format based on GS1 standards (e.g., a date code expressed in a national format that could be used to encode a date field in a GS1 AIDC data carrier, brand owner name, consumer declarations).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "non-hri"
        },
        {
          "term": "Number System Character",
          "definition": "Deprecated in favour of: U.P.C. Prefix",
          "links": [],
          "examples": [],
