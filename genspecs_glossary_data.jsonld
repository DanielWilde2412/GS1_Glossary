          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "individual_provider"
        },
        {
          "term": "instance level GS1 identifier",
          "definition": "An identifier of an individual entity (e.g., one specific trade item, allocated the same GTIN as others within a class, but distinguished by serial number).",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "instance_level_gs1_identifier"
        },
        {
          "term": "Interleaved 2 of 5 symbology",
