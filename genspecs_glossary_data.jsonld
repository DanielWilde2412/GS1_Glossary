          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gs1-8_prefix"
        },
        {
          "term": "GTIN allocator",
          "definition": "The party that warrants the trade item declarations about a trade item to which they allocate a GTIN. This is the party who is the licensee of the GTIN applied to a specific trade item.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_allocator"
        },
        {
          "term": "GTIN plus attribute(s) flag",
          "definition": "A trigger in systems to determine if additional processing is required by a barcode user for a given GTIN.",
          "links": [],
          "examples": [],
          "crossRefs": [],
          "date": "2026-05-28",
          "sourceName": "GS1 General Specifications",
          "sourceURL": "https://ref.gs1.org/standards/genspecs",
          "id": "gtin_plus_attribute_s_flag"
        },
        {
          "term": "GTIN‑12",
          "definition": "The 12-digit GS1 identification key composed of a U.P.C. Company Prefix, item reference and check digit used to identify trade items.",
          "links": [],
          "examples": [],
          "crossRefs": [],
